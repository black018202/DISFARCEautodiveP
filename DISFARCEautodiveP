-- Espera 3 segundos depois de executar antes de iniciar o resto do script
task.wait(3)

local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")

local localPlayer = Players.LocalPlayer

-- Começam desativados por padrão
local autoDive = false
local infStamina = false
local toggleKey = Enum.KeyCode.L -- liga/desliga tudo (clique duplo: só auto dive)
local diveKey = Enum.KeyCode.F -- liga/desliga só o auto dive
-- Modo 2 = clique duplo no L (auto dive SEM stamina). Nesse modo a F também não liga a stamina.
-- Modo 1 = normal (a F liga/desliga o auto dive e a stamina fica ligada).
local modoSemStamina = false

-- Configurações de velocidade e stamina
local y, z = 26, 16
local speedValue = 24

-- Filtros do auto dive (studs/s). Ajuste se precisar.
-- Bola parada ou devagar no chão: não mergulha abaixo desta velocidade.
local MIN_BALL_SPEED = 11
-- Bola no ar (acima desta altura em relação ao jogador): precisa de mais velocidade.
local AIR_HEIGHT = 4
local MIN_AIR_SPEED = 13
-- Bola acima da sua cabeça: se o centro da bola estiver mais alto que isso
-- (studs acima do centro do seu personagem), ela passa por cima e não mergulha.
local OVER_HEAD_HEIGHT = 4.0
-- A bola precisa estar VINDO na sua direção com pelo menos esta velocidade.
local MIN_APPROACH_SPEED = 5
-- Só mergulha se a bola chegar em você em até este tempo (segundos).
local MAX_TIME_TO_REACH = 1.2
-- Distância máxima (studs) que a bola pode passar de você para valer o mergulho.
-- (alto de propósito: chute no canto passa longe de você e precisa de mergulho)
local MAX_MISS_DISTANCE = 30
-- Tempo mínimo entre um mergulho e outro (evita ficar mergulhando em loop).
local DIVE_COOLDOWN = 0.7
local bolaNosPes = false -- true enquanto a bola está nos pés de alguém
local bolaNosMeusPes = false -- true se a bola estava nos MEUS pés (não pula quando eu chuto)

-- q = alcance (studs) | t = quão à frente ele enxerga | u = quão atrás
local q, r, s, t, u = 21, DIVE_COOLDOWN, 0.6, -19, 4
local v, w, x = 0, 0, nil
local tentandoReconectar = false

local function tentarReconectar()
    if tentandoReconectar then return end
    tentandoReconectar = true
    task.wait(2)
    if game.JobId and game.JobId ~= "" then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
    else
        TeleportService:Teleport(game.PlaceId, localPlayer)
    end
end

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    tentandoReconectar = false
    task.wait(2)
    TeleportService:Teleport(game.PlaceId, localPlayer)
end)

GuiService.ErrorMessageChanged:Connect(function(errorMessage)
    if errorMessage and #errorMessage > 0 then
        tentarReconectar() -- corrigido: antes chamava a variável booleana
    end
end)

local function sendKey(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.defer(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
end

local function D()
    if x and x:IsDescendantOf(Workspace) then return x end
    local E = Workspace:FindFirstChild("TPS") or Workspace:FindFirstChild("Ball") or Workspace:FindFirstChild("Football")
    if E then 
        if E:IsA("BasePart") then x = E return E 
        elseif E:IsA("Model") and E.PrimaryPart then x = E.PrimaryPart return E.PrimaryPart end 
    end
    for _, F in ipairs(Workspace:GetChildren()) do 
        local G = F.Name:lower()
        if G:find("ball") or G:find("tps") or G:find("bola") then 
            if F:IsA("BasePart") and F.CanCollide then x = F return F 
            elseif F:IsA("Model") and F.PrimaryPart then x = F.PrimaryPart return F.PrimaryPart end 
        end 
    end
    x = nil return nil
end

local function H(I)
    if I:FindFirstChildOfClass("Weld") or I:FindFirstChildOfClass("WeldConstraint") or I:FindFirstChildOfClass("Motor6D") then return true end
    local J = I.Parent if J and J:FindFirstChildOfClass("Humanoid") then return true end
    for _, K in ipairs(I:GetChildren()) do 
        if (K:IsA("SelectionBox") or K:IsA("Highlight") or K:IsA("BillboardGui") or K:IsA("SurfaceGui")) and K.Visible then return true end 
    end
    local L = I.Position 
    for _, M in ipairs(Players:GetPlayers()) do 
        local N = M.Character 
        if N then 
            local O = N:FindFirstChild("HumanoidRootPart")
            if O and (L - O.Position).Magnitude <= 3.5 then return true end 
        end 
    end
    return false
end

-- Retorna true se o auto dive deve ser ignorado:
-- bola parada, bola devagar, ou bola devagar no ar.
local function ignorarBola(bola, raiz)
    local vel = bola.AssemblyLinearVelocity
    local horizontal = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local total = vel.Magnitude

    -- parada ou devagar
    if horizontal < MIN_BALL_SPEED then return true end

    local altura = bola.Position.Y - raiz.Position.Y

    -- passando por cima da cabeça: não mergulha
    if altura > OVER_HEAD_HEIGHT then return true end

    -- no ar e devagar
    if altura > AIR_HEIGHT and total < MIN_AIR_SPEED then return true end

    -- a bola precisa estar vindo na sua direção (e não se afastando ou passando longe)
    local rel = Vector3.new(bola.Position.X - raiz.Position.X, 0, bola.Position.Z - raiz.Position.Z)
    local dist = rel.Magnitude
    if dist < 0.1 then return false end
    local dir = rel / dist
    local velH = Vector3.new(vel.X, 0, vel.Z)
    local approach = -dir:Dot(velH) -- positivo = bola vindo na sua direção
    if approach < MIN_APPROACH_SPEED then return true end

    -- tempo até chegar em você
    if dist / approach > MAX_TIME_TO_REACH then return true end

    -- por onde a bola vai passar: se passa longe, não mergulha
    local lateral = (velH - dir * dir:Dot(velH)).Magnitude * (dist / approach)
    if lateral > MAX_MISS_DISTANCE then return true end

    return false
end

-- Tempo máximo (segundos) entre dois cliques no P para contar como clique duplo.
local DOUBLE_CLICK_TIME = 0.35
local ultimoClique = 0

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == toggleKey then
        local agora = os.clock()
        if (agora - ultimoClique) <= DOUBLE_CLICK_TIME then
            -- Clique duplo: desliga a stamina/speed e deixa só o auto dive
            autoDive = true
            infStamina = false
            modoSemStamina = true -- entra no modo 2
            ultimoClique = 0 -- evita que um 3º clique conte como outro duplo
            print("Scripts: SOMENTE Auto Dive (Stamina/Speed desativados)")
        else
            -- Clique simples: liga/desliga tudo (se estiver só com auto dive, desliga normalmente)
            autoDive = not autoDive
            infStamina = autoDive
            modoSemStamina = false -- clique simples volta ao modo 1
            ultimoClique = agora
            print("Scripts:", autoDive and "ATIVADOS (Auto Dive + Stamina)" or "DESATIVADOS")
        end
    elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == diveKey then
        autoDive = not autoDive
        if modoSemStamina then
            -- Modo 2: liga/desliga o auto dive, sem stamina em nenhum dos dois estados.
            infStamina = false
            print("F (modo 2):", autoDive and "Auto Dive ATIVADO (sem stamina)" or "Auto Dive DESATIVADO (sem stamina)")
        else
            -- Modo 1: liga/desliga o auto dive. A stamina/speed fica sempre ligada.
            infStamina = true
            print("F:", autoDive and "Auto Dive ATIVADO (+ Stamina)" or "Auto Dive DESATIVADO (Stamina continua)")
        end
    end
end)

local R, S = 0, 0.03
RunService.Heartbeat:Connect(function(T)
    local U = localPlayer.Character if not U then return end

    -- Executa o boost de velocidade/stamina se ativado
    if infStamina then
        local targetSpd = speedValue
        local V = U:FindFirstChildOfClass("Humanoid")
        local W = U:FindFirstChild("HumanoidRootPart")
        if W and V and V.Health > 0 then
            local X = V.MoveDirection 
            if X.Magnitude == 0 then 
                local Y = Vector3.new(W.AssemblyLinearVelocity.X, 0, W.AssemblyLinearVelocity.Z)
                if Y.Magnitude > 1 then X = Y.Unit end 
            end
            if X.Magnitude > 0 then 
                local Z = targetSpd - z 
                local _ = Vector3.new(X.X, 0, X.Z).Unit * (Z * T)
                W.CFrame = W.CFrame + _ 
            end
        end
    end

    if not autoDive then return end

    local a0 = os.clock() if (a0 - R) < S then return end R = a0
    local a1 = U:FindFirstChild("HumanoidRootPart")
    local a2 = U:FindFirstChildOfClass("Humanoid") 
    if not a1 or not a2 then return end
    local a3 = D() if not a3 then return end

    -- Acompanha a bola nos pés de alguém e detecta o momento em que ela SAI
    -- dos pés (o chute). Isso é lido antes do cooldown para não perder o chute.
    local nosPes = H(a3)
    local acabouDeChutar = false
    if nosPes then
        bolaNosPes = true
        -- bola nos meus próprios pés? então se ela sair, fui eu que chutei
        bolaNosMeusPes = (a3.Position - a1.Position).Magnitude <= 3.5
    elseif bolaNosPes then
        bolaNosPes = false
        acabouDeChutar = not bolaNosMeusPes
    end

    if (a0 - v) < r then return end
    if nosPes then return end

    -- CHUTE: a bola saiu dos pés de outro jogador. Ignora os filtros de
    -- velocidade (a bola ainda está pegando velocidade) e pula na hora.
    if acabouDeChutar then
        local k4 = a3.Position local k6 = (k4 - a1.Position).Magnitude
        local k7 = a1.CFrame:PointToObjectSpace(k4)
        if k6 <= q and k7.Z >= t and k7.Z <= u and (k7.X > 1.5 or k7.X < -1.5) then
            v = a0
            sendKey((k7.X > 1.5) and Enum.KeyCode.E or Enum.KeyCode.Q)
        end
        return
    end

    -- Bola parada, devagar ou devagar no ar: não pega o auto dive
    if ignorarBola(a3, a1) then return end

    local a4 = a3.Position local a5 = a1.Position local a6 = (a4 - a5).Magnitude
    if a6 <= q then
        local a7 = a1.CFrame:PointToObjectSpace(a4)
        if a7.Z >= t and a7.Z <= u then
            if a7.X > 1.5 or a7.X < -1.5 then
                -- pula na hora
                v = a0
                sendKey((a7.X > 1.5) and Enum.KeyCode.E or Enum.KeyCode.Q)
            end
        end
    end
end)
