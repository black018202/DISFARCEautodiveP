task.wait(3)

local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")

local localPlayer = Players.LocalPlayer

-- Começam desativados por padrão
local autoDive = false
local infStamina = false
local toggleKey = Enum.KeyCode.L -- liga/desliga tudo (clique duplo: só auto dive)
local diveKey = Enum.KeyCode.F -- liga/desliga só o auto dive
-- Modo 2 = clique duplo no L (auto dive SEM stamina). Nesse modo a F também não liga a stamina.
-- Modo 1 = normal (a F liga/desliga o auto dive e a stamina fica ligada).
local modoSemStamina = false

-- Configurações de velocidade e stamina
local y, z = 26, 16
local speedValue = 24

-- AUTO DIVE (o mesmo do script de Farm): pega a bola olhando a TRAJETÓRIA,
-- onde ela cruza a linha do goleiro, e confirma o lado antes de pular.
local DIVE_RANGE = 22         -- alcance pra bola vindo de frente (antes 22): enxerga chute forte de mais longe
local DIVE_FRONT = -32           -- até onde na frente (Z) já enxerga a bola vindo (antes -19)
local DIVE_TRIGGER_TIME = 0.30   -- pula quando a bola chega em até X s (base)...
local DIVE_LATERAL_TIME = 0.012  -- ...mais X s por stud de distância lateral (bola longe do goleiro = pula antes)
local DIVE_MAX_LATERAL = 20      -- limite da distância lateral usada nessa conta
local DIVE_URGENT_TIME = 0.15    -- bola chegando em menos que isso: pula na hora, sem confirmar
local DIVE_CONFIRM_FRAMES = 2    -- senão precisa dar o MESMO lado em X checagens seguidas
local DIVE_CONFIRM_WINDOW = 0.1  -- as checagens precisam ser seguidas (em segundos)
local DIVE_MAX_BALL_HEIGHT = 3.5 -- bola mais alta que isso acima do seu HumanoidRootPart = por cima da cabeça, não pula
-- BOLA RETA NO PERSONAGEM: se a bola vai passar perto do centro do seu personagem ela bate no
-- corpo e não precisa de mergulho. A "zona reta" cresce com o tempo até a bola chegar, porque
-- a previsão erra mais quando a bola ainda está longe. Aumente se ainda pular pro lado à toa.
local DIVE_STRAIGHT_BASE = 2.2       -- studs de cada lado do centro (base)
local DIVE_STRAIGHT_PER_SEC = 2.5    -- + X studs por segundo de antecedência
local DIVE_FALL_SPEED = 12       -- bola alta só conta como "caindo" se descer mais rápido que isso (studs/s)
local DIVE_HIGH_STRAIGHT = 4         -- bola ALTA indo a menos de X studs de você (reta no personagem) = por cima da cabeça, não pula
local FAST_BALL = 35            -- acima disso a bola é chute/passe: perto de jogador não conta como "bola presa"


-- q = alcance (studs) | t = quão à frente ele enxerga | u = quão atrás
local q, r, s, t, u = 22, 0.03, 0.6, -19, 4
local v, w, x = 0, 0, nil
local tentandoReconectar = false

local function tentarReconectar()
    if tentandoReconectar then return end
    tentandoReconectar = true
    task.wait(2)
    if game.JobId and game.JobId ~= "" then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
    else
        TeleportService:Teleport(game.PlaceId, localPlayer)
    end
end

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    tentandoReconectar = false
    task.wait(2)
    TeleportService:Teleport(game.PlaceId, localPlayer)
end)

GuiService.ErrorMessageChanged:Connect(function(errorMessage)
    if errorMessage and #errorMessage > 0 then
        tentarReconectar() -- corrigido: antes chamava a variável booleana
    end
end)

local function sendKey(key)
    VirtualInputManager:SendKeyEvent(true, key, false, game)
    task.defer(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end)
end

local function D()
    if x and x:IsDescendantOf(Workspace) then return x end
    local E = Workspace:FindFirstChild("TPS") or Workspace:FindFirstChild("Ball") or Workspace:FindFirstChild("Football")
    if E then 
        if E:IsA("BasePart") then x = E return E 
        elseif E:IsA("Model") and E.PrimaryPart then x = E.PrimaryPart return E.PrimaryPart end 
    end
    for _, F in ipairs(Workspace:GetChildren()) do 
        local G = F.Name:lower()
        if G:find("ball") or G:find("tps") or G:find("bola") then 
            if F:IsA("BasePart") and F.CanCollide then x = F return F 
            elseif F:IsA("Model") and F.PrimaryPart then x = F.PrimaryPart return F.PrimaryPart end 
        end 
    end
    x = nil return nil
end

local function H(I)
    if I:FindFirstChildOfClass("Weld") or I:FindFirstChildOfClass("WeldConstraint") or I:FindFirstChildOfClass("Motor6D") then return true end
    local J = I.Parent if J and J:FindFirstChildOfClass("Humanoid") then return true end
    for _, K in ipairs(I:GetChildren()) do 
        if (K:IsA("SelectionBox") or K:IsA("Highlight") or K:IsA("BillboardGui") or K:IsA("SurfaceGui")) and K.Visible then return true end 
    end
    local L = I.Position 
    for _, M in ipairs(Players:GetPlayers()) do 
        local N = M.Character 
        if N then 
            local O = N:FindFirstChild("HumanoidRootPart")
            if O and (L - O.Position).Magnitude <= 3.5 then return true end 
        end 
    end
    return false
end

local pendingKey, pendingCount, pendingTime = nil, 0, 0
local lastBallObj, lastBallPos, lastBallTime = nil, nil, 0

-- COMPENSAÇÃO DE PING: a bola que você vê está atrasada em relação ao servidor,
-- então com ping alto o pulo precisa sair um pouco mais cedo.
local Stats = game:GetService("Stats")
local DIVE_PING_COMP = 0.5   -- fração do ping somada à antecedência do pulo (0 = desliga)
local pingSeconds = 0

task.spawn(function()
    while true do
        local ok, ms = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(ms) == "number" then
            pingSeconds = math.clamp(ms / 1000, 0, 0.4)
        end
        task.wait(0.5)
    end
end)

-- Bola presa (solda/personagem): vale mesmo com a bola rápida
local function isBallAttached(I)
    if I:FindFirstChildOfClass("Weld") or I:FindFirstChildOfClass("WeldConstraint") or I:FindFirstChildOfClass("Motor6D") then return true end
    local J = I.Parent if J and J:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

-- Decide o lado do pulo. Retorna (tecla, urgente) ou nil
local function diveKeyFor(a1, ballPos, ballVel)
    local a7 = a1.CFrame:PointToObjectSpace(ballPos)
    local dist = (ballPos - a1.Position).Magnitude

    -- velocidade da bola em relação ao goleiro (Z > 0 = bola vindo na direção dele)
    local lv = a1.CFrame:VectorToObjectSpace(ballVel)

    if a7.Z < 0 and lv.Z > 3 then
        -- TRAJETÓRIA: bola vindo de frente
        if dist > DIVE_RANGE or a7.Z < DIVE_FRONT then return nil end
        local tReach = -a7.Z / lv.Z                         -- tempo até a bola chegar na linha do goleiro
        local crossX = a7.X + lv.X * tReach                 -- onde ela vai cruzar (esquerda/direita)
        local need = DIVE_TRIGGER_TIME + math.min(math.abs(crossX), DIVE_MAX_LATERAL) * DIVE_LATERAL_TIME
                   + pingSeconds * DIVE_PING_COMP
        if tReach > need then return nil end                -- ainda cedo: espera pra não errar o lado

        -- altura prevista da bola quando chegar na sua linha (com gravidade)
        local predictedY = ballPos.Y + ballVel.Y * tReach - 0.5 * Workspace.Gravity * tReach * tReach
        if predictedY - a1.Position.Y > DIVE_MAX_BALL_HEIGHT then return nil end -- vai passar por cima da cabeça

        -- bola ALTA vindo reta no seu personagem (não pros lados): passa por cima da cabeça.
        -- Usa a altura de AGORA (não só a prevista pela gravidade), então não pula nela.
        local heightNow = ballPos.Y - a1.Position.Y
        if heightNow > DIVE_MAX_BALL_HEIGHT and ballVel.Y > -DIVE_FALL_SPEED
            and math.abs(crossX) < DIVE_HIGH_STRAIGHT then return nil end

        local urgent = tReach <= DIVE_URGENT_TIME + pingSeconds * DIVE_PING_COMP
        -- zona reta: bola indo no corpo do personagem (cresce com o tempo até chegar)
        local straight = DIVE_STRAIGHT_BASE + DIVE_STRAIGHT_PER_SEC * tReach
        if crossX > straight then return Enum.KeyCode.E, urgent
        elseif crossX < -straight then return Enum.KeyCode.Q, urgent end
        return nil                                          -- vai no meio, direto no goleiro
    end

    -- bola não vem de frente: regra original (lado pela posição atual)
    if ballPos.Y - a1.Position.Y > DIVE_MAX_BALL_HEIGHT then return nil end -- bola já está acima da cabeça
    if dist > q or a7.Z < t or a7.Z > u then return nil end
    -- bola que JÁ PASSOU por você (na linha ou atrás e indo pra trás): mergulhar agora é pro lado errado
    if a7.Z > -1 and lv.Z > 3 then return nil end
    if a7.X > DIVE_STRAIGHT_BASE then return Enum.KeyCode.E, false elseif a7.X < -DIVE_STRAIGHT_BASE then return Enum.KeyCode.Q, false end
    return nil
end


-- Tempo máximo (segundos) entre dois cliques no P para contar como clique duplo.
local DOUBLE_CLICK_TIME = 0.35
local ultimoClique = 0

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == toggleKey then
        local agora = os.clock()
        if (agora - ultimoClique) <= DOUBLE_CLICK_TIME then
            -- Clique duplo: desliga a stamina/speed e deixa só o auto dive
            autoDive = true
            infStamina = false
            modoSemStamina = true -- entra no modo 2
            ultimoClique = 0 -- evita que um 3º clique conte como outro duplo
            print("Scripts: SOMENTE Auto Dive (Stamina/Speed desativados)")
        else
            -- Clique simples: liga/desliga tudo (se estiver só com auto dive, desliga normalmente)
            autoDive = not autoDive
            infStamina = autoDive
            modoSemStamina = false -- clique simples volta ao modo 1
            ultimoClique = agora
            print("Scripts:", autoDive and "ATIVADOS (Auto Dive + Stamina)" or "DESATIVADOS")
        end
    elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == diveKey then
        autoDive = not autoDive
        if modoSemStamina then
            -- Modo 2: liga/desliga o auto dive, sem stamina em nenhum dos dois estados.
            infStamina = false
            print("F (modo 2):", autoDive and "Auto Dive ATIVADO (sem stamina)" or "Auto Dive DESATIVADO (sem stamina)")
        else
            -- Modo 1: liga/desliga o auto dive. A stamina/speed fica sempre ligada.
            infStamina = true
            print("F:", autoDive and "Auto Dive ATIVADO (+ Stamina)" or "Auto Dive DESATIVADO (Stamina continua)")
        end
    end
end)

local R, S = 0, 0 -- checa a bola a cada frame

RunService.Heartbeat:Connect(function(T)
    local U = localPlayer.Character if not U then return end

    -- Executa o boost de velocidade/stamina se ativado
    if infStamina then
        local targetSpd = speedValue
        local V = U:FindFirstChildOfClass("Humanoid")
        local W = U:FindFirstChild("HumanoidRootPart")
        if W and V and V.Health > 0 then
            local X = V.MoveDirection 
            if X.Magnitude == 0 then 
                local Y = Vector3.new(W.AssemblyLinearVelocity.X, 0, W.AssemblyLinearVelocity.Z)
                if Y.Magnitude > 1 then X = Y.Unit end 
            end
            if X.Magnitude > 0 then 
                local Z = targetSpd - z 
                local _ = Vector3.new(X.X, 0, X.Z).Unit * (Z * T)
                W.CFrame = W.CFrame + _ 
            end
        end
    end

    if not autoDive then return end

    local a0 = os.clock() if (a0 - R) < S then return end R = a0
    local a1 = U:FindFirstChild("HumanoidRootPart")
    local a2 = U:FindFirstChildOfClass("Humanoid") 
    if not a1 or not a2 then return end
    if (a0 - v) < r then return end
    local a3 = D() if not a3 then return end
    
    local velBola = a3.AssemblyLinearVelocity or a3.Velocity

    -- Se a velocidade informada vier zerada/baixa demais, usa o deslocamento real da bola entre frames
    local nowPos = a3.Position
    if lastBallObj == a3 and (a0 - lastBallTime) > 0 and (a0 - lastBallTime) < 0.1 then
        local posVel = (nowPos - lastBallPos) / (a0 - lastBallTime)
        local posH = Vector3.new(posVel.X, 0, posVel.Z).Magnitude
        local repH = Vector3.new(velBola.X, 0, velBola.Z).Magnitude
        if posH > 8 and posH < 300 and posH > repH * 1.5 then velBola = posVel end
    end
    lastBallObj, lastBallPos, lastBallTime = a3, nowPos, a0

    -- Ignora se a bola estiver devagar ou parada (velocidade horizontal abaixo de 2.5)
    local velHorizontal = Vector3.new(velBola.X, 0, velBola.Z).Magnitude
    if velHorizontal <= 2.5 then return end

    -- Bola presa: devagar usa a checagem completa (H); chute/passe rápido só olha se está presa de verdade,
    -- assim um jogador perto da bola não bloqueia o pulo
    if velHorizontal < FAST_BALL then
        if H(a3) then return end
    elseif isBallAttached(a3) then
        return
    end

    local diveTecla, urgent = diveKeyFor(a1, a3.Position, velBola)
    if diveTecla then
        -- confirma o lado em checagens seguidas antes de pular (bola chegando já = pula na hora)
        if diveTecla == pendingKey and (a0 - pendingTime) <= DIVE_CONFIRM_WINDOW then
            pendingCount += 1
        else
            pendingKey, pendingCount = diveTecla, 1
        end
        pendingTime = a0

        if urgent or pendingCount >= DIVE_CONFIRM_FRAMES then
            pendingKey, pendingCount = nil, 0
            v = a0 sendKey(diveTecla)
        end
    else
        pendingKey, pendingCount = nil, 0
    end
end)
